# Copy to .env and fill in. Never commit .env. The back end and the agent read this one file.

# Model, Groq directly (model/README.md):
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-120b
LLM_FALLBACK_MODEL=openai/gpt-oss-20b
# Or through Portkey (the saved config then decides the model):
# LLM_BASE_URL=https://api.portkey.ai/v1
# PORTKEY_API_KEY=
# PORTKEY_CONFIG_SLUG=

# OCR and embeddings (extraction)
GEMINI_API_KEY=

# Any backend/config/app.yaml key can be overridden as APP__<SECTION>__<KEY>, for example:
# APP__QDRANT__URL=http://localhost:6333
