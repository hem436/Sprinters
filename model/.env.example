# Copy to .env (never commit it). Groq directly:
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-120b
LLM_FALLBACK_MODEL=openai/gpt-oss-20b
# The planner's own model (default: app.yaml llm.route_model, openai/gpt-oss-20b), so route and answer calls use
# separate per-minute limits; more models give more room on Groq's free tier (comma list)
# LLM_ROUTE_MODEL=openai/gpt-oss-20b
# LLM_MORE_MODELS=qwen/qwen3.8-27b,openai/gpt-oss-safeguard-20b
# Or through Portkey (the saved config then decides the model):
# LLM_BASE_URL=https://api.portkey.ai/v1
# PORTKEY_API_KEY=
# PORTKEY_CONFIG_SLUG=
