# Copy to .env (never commit it). Groq directly:
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-120b
LLM_FALLBACK_MODEL=openai/gpt-oss-20b
# Or through Portkey (the saved config then decides the model):
# LLM_BASE_URL=https://api.portkey.ai/v1
# PORTKEY_API_KEY=
# PORTKEY_CONFIG_SLUG=
