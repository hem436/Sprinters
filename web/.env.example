# true: the app uses the fixtures in src/api/mock and needs no backend.
# false: the app calls the FastAPI service through VITE_API_BASE.
VITE_USE_MOCKS=true
# Base path of the API. In dev, /api is proxied to API_PROXY_TARGET (default http://localhost:8000).
VITE_API_BASE=/api
# Max upload size in MB. Keep it equal to the server limit (contract 10).
VITE_MAX_UPLOAD_MB=25
# Admin login, checked in the web app only. Put the SHA-256 hash of the password here, never the password:
#   printf '%s' 'your-password' | sha256sum
# Leave the hash empty to keep the admin pages open. The API itself stays open either way.
VITE_ADMIN_USERNAME=admin
VITE_ADMIN_PASSWORD_SHA256=
