# Copy to .env and fill in. Never commit .env.

# Gemini: vision OCR (contract 10 X5) and embeddings (X9). A second key on another Google Cloud project is used
# when the first one runs out of daily quota.
GEMINI_API_KEY=
GEMINI_FALLBACK_KEY=

# Qdrant. Empty = local mode, stored on disk under data/qdrant (no Docker needed).
# Docker: docker run -p 6333:6333 qdrant/qdrant  then  QDRANT_URL=http://localhost:6333
QDRANT_URL=
QDRANT_API_KEY=

# Where the SQLite knowledge store, the uploaded files and the local Qdrant live.
EXTRACTION_DATA_DIR=data

# Optional YAML file with config overrides (keys as in contract 10 section 12, for example extract.max_mb).
EXTRACTION_CONFIG=
